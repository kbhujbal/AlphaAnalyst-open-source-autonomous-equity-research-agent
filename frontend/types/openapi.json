              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "dcf_scenario": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DCFScenario-Input"
              },
              {
                "type": "null"
              }
            ]
          },
          "ticker": {
            "type": "string",
            "pattern": "^[A-Z]{1,5}$",
            "title": "Ticker",
            "description": "US stock ticker, 1-5 uppercase letters."
          }
        },
        "type": "object",
        "required": [
          "ticker"
        ],
        "title": "AnalyzeRequest"
      },
      "AnalyzeResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "const": "queued",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status"
        ],
        "title": "AnalyzeResponse"
      },
      "BoundaryEvidence": {
        "properties": {
          "period_end": {
            "type": "string",
            "format": "date",
            "title": "Period End"
          },
          "locator": {
            "type": "string",
            "title": "Locator"
          },
          "payload_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Payload Hash"
          }
        },
        "type": "object",
        "required": [
          "period_end",
          "locator",
          "payload_hash"
        ],
        "title": "BoundaryEvidence"
      },
      "CalculationRecord": {
        "properties": {
          "trace": {
            "$ref": "#/components/schemas/CalculationTrace"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/CalculationSource"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "type": "object",
        "required": [
          "trace",
          "sources"
        ],
        "title": "CalculationRecord"
      },
      "CalculationSource": {
        "properties": {
          "observation": {
            "$ref": "#/components/schemas/FinancialObservation"
          },
          "passages": {
            "items": {
              "$ref": "#/components/schemas/SourcePassage"
            },
            "type": "array",
            "title": "Passages"
          }
        },
        "type": "object",
        "required": [
          "observation",
          "passages"
        ],
        "title": "CalculationSource"
      },
      "CalculationStep": {
        "properties": {
          "node": {
            "type": "string",
            "title": "Node"
          },
          "operation": {
            "type": "string",
            "title": "Operation"
          },
          "inputs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Inputs"
          },
          "value": {
            "type": "string",
            "title": "Value"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "observation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observation Id"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "node",
          "operation",
          "value",
          "unit"
        ],
        "title": "CalculationStep"
      },
      "CalculationTrace": {
        "properties": {
          "engine": {
            "type": "string",
            "const": "decimal-28-half-even-v1",
            "title": "Engine",
            "default": "decimal-28-half-even-v1"
          },
          "recipe": {
            "type": "string",
            "enum": [
              "growth-v1",
              "net-margin-v1",
              "ocf-margin-v1",
              "dcf-fcff-v1",
              "comps-v1"
            ],
            "title": "Recipe"
          },
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "bindings": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Bindings"
          },
          "scenario": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DCFScenario-Output"
              },
              {
                "type": "null"
              }
            ]
          },
          "valuation_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valuation Date"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/CalculationStep"
            },
            "type": "array",
            "title": "Steps"
          },
          "outputs": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Outputs"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "calculation_id": {
            "type": "string",
            "title": "Calculation Id",
            "readOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "recipe",
          "ticker",
          "bindings",
          "steps",
          "outputs",
          "currency",
          "calculation_id"
        ],
        "title": "CalculationTrace"
      },
      "CapturedDocument": {
        "properties": {
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "scope": {
            "type": "string",
            "enum": [
              "normalized_filing",
              "transcript",
              "feed_excerpt",
              "provider_record"
            ],
            "title": "Scope"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time",
            "title": "Retrieved At"
          },
          "content_hash": {
            "type": "string",
            "title": "Content Hash",
            "readOnly": true
          },
          "document_id": {
            "type": "string",
            "title": "Document Id",
            "readOnly": true
          }
        },
        "type": "object",
        "required": [
          "ticker",
          "source_id",
          "source_url",
          "scope",
          "text",
          "retrieved_at",
          "content_hash",
          "document_id"
        ],
        "title": "CapturedDocument"
      },
      "Citation": {
        "properties": {
          "tag": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^F[1-9]\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tag"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "filing",
              "transcript",
              "news",
              "fact",
              "price",
              "macro",
              "estimates"
            ],
            "title": "Source Type"
          },
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "snippet": {
            "type": "string",
            "title": "Snippet"
          },
          "passages": {
            "items": {
              "$ref": "#/components/schemas/SourcePassage"
            },
            "type": "array",
            "title": "Passages"
          },
          "observation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observation Id"
          },
          "calculation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Calculation Id"
          }
        },
        "type": "object",
        "required": [
          "source_type",
          "source_id",
          "snippet"
        ],
        "title": "Citation"
      },
      "ClaimAudit": {
        "properties": {
          "claim_id": {
            "type": "string",
            "title": "Claim Id"
          },
          "section": {
            "type": "string",
            "enum": [
              "executive_summary",
              "financial_snapshot",
              "recent_catalysts",
              "valuation",
              "earnings_call_tone_shift",
              "alt_data_signals",
              "bull_case",
              "bear_case",
              "risks"
            ],
            "title": "Section"
          },
          "kind": {
            "type": "string",
            "enum": [
              "quote",
              "financial",
              "calculation",
              "interpretation"
            ],
            "title": "Kind"
          },
          "proposed_text": {
            "type": "string",
            "title": "Proposed Text"
          },
          "rendered_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rendered Text"
          },
          "citations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Citations"
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "needs_review",
              "rejected"
            ],
            "title": "Status"
          },
          "observation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observation Id"
          },
          "calculation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Calculation Id"
          },
          "calculation_output": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Calculation Output"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/NumericalCheck"
            },
            "type": "array",
            "title": "Checks"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons"
          }
        },
        "type": "object",
        "required": [
          "claim_id",
          "section",
          "kind",
          "proposed_text",
          "citations",
          "status"
        ],
        "title": "ClaimAudit"
      },
      "DCFScenario-Input": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "rationale": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 12,
            "title": "Rationale"
          },
          "wacc": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMaximum": 1.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Wacc"
          },
          "terminal_growth": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMaximum": 1.0,
                "exclusiveMinimum": -1.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Terminal Growth"
          },
          "fcff_margin": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": -1.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Fcff Margin"
          },
          "projection_years": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 3.0,
            "title": "Projection Years",
            "default": 5
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "rationale",
          "wacc",
          "terminal_growth",
          "fcff_margin"
        ],
        "title": "DCFScenario",
        "description": "Analyst assumptions, never represented as historical reported facts."
      },
      "DCFScenario-Output": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "rationale": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 12,
            "title": "Rationale"
          },
          "wacc": {
            "type": "string",
            "title": "Wacc"
          },
          "terminal_growth": {
            "type": "string",
            "title": "Terminal Growth"
          },
          "fcff_margin": {
            "type": "string",
            "title": "Fcff Margin"
          },
          "projection_years": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 3.0,
            "title": "Projection Years",
            "default": 5
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "rationale",
          "wacc",
          "terminal_growth",
          "fcff_margin"
        ],
        "title": "DCFScenario",
        "description": "Analyst assumptions, never represented as historical reported facts."
      },
      "ExportLinks": {
        "properties": {
          "pdf": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pdf"
          },
          "excel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Excel"
          }
        },
        "type": "object",
        "title": "ExportLinks"
      },
      "FinancialObservation": {
        "properties": {
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "metric": {
            "type": "string",
            "title": "Metric"
          },
          "tag": {
            "type": "string",
            "title": "Tag"
          },
          "value": {
            "type": "string",
            "title": "Value"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          },
          "period": {
            "$ref": "#/components/schemas/ReportingPeriod"
          },
          "dimensions": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Dimensions"
          },
          "source": {
            "$ref": "#/components/schemas/ObservationSource"
          },
          "payload_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Payload Hash"
          },
          "reported_decimals": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reported Decimals"
          },
          "scale": {
            "type": "integer",
            "const": 1,
            "title": "Scale",
            "default": 1
          },
          "quality_flags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Quality Flags"
          },
          "observation_id": {
            "type": "string",
            "title": "Observation Id",
            "readOnly": true
          }
        },
        "type": "object",
        "required": [
          "ticker",
          "metric",
          "tag",
          "value",
          "unit",
          "period",
          "source",
          "payload_hash",
          "observation_id"
        ],
        "title": "FinancialObservation"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "db_ok": {
            "type": "boolean",
            "title": "Db Ok"
          },
          "redis_ok": {
            "type": "boolean",
            "title": "Redis Ok"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "db_ok",
          "redis_ok"
        ],
        "title": "HealthResponse"
